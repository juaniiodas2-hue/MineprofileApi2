        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Notch\"\n}"
        }
      }
    },
    {
      "name": "4. Crear con datos invalidos (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Detalla el campo\", () => pm.expect(pm.response.json().error.detalles[0].campo).to.eql(\"nombre\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/perfiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "perfiles"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"a\"\n}"
        }
      }
    },
    {
      "name": "5. Listar perfiles (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Trae items\", () => pm.expect(pm.response.json().items).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/perfiles?limite=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
